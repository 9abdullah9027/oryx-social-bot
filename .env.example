# ==========================================
# ORYX Social Bot - Environment Configuration
# ==========================================

# Meta Graph API - Instagram Business / Creator Account ID
# (Obtained from Graph API Explorer or your Facebook Page linked to Instagram)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Meta Graph API - Long-Lived User Access Token (valid for 60 days)
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here

# Discord Channel Webhook URL
# (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# (Optional) Discord Webhook Appearance
DISCORD_BOT_USERNAME="ORYX Social"
DISCORD_BOT_AVATAR_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/instagram.png"

# (Optional) Role ID to mention on new post (e.g. 123456789012345678). Leave empty for no mention.
DISCORD_ROLE_ID=

# (Optional) First-run behavior:
# Set to "true" to notify the single latest post when running for the first time.
# Set to "false" to only record current posts and notify on new posts published after setup. (Default: false)
INITIAL_NOTIFICATION=false

# (Optional) Max posts to inspect on each run (Default: 5)
POST_LIMIT=5
